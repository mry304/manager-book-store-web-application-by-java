# Copy this file to .env and replace every placeholder. Never commit .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=BOOKS
SMTP_STARTTLS=true
APP_BASE_URL=http://localhost:8080/onlinebookstore

# PayOS VietQR Payment Gateway
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL=http://localhost:8080/onlinebookstore/payment-success.jsp
PAYOS_CANCEL_URL=http://localhost:8080/onlinebookstore/checkout

# GHN (Giao Hang Nhanh) - Staging: https://dev-online-gateway.ghn.vn
GHN_BASE_URL=https://dev-online-gateway.ghn.vn
GHN_TOKEN=your-ghn-token
GHN_SHOP_ID=your-ghn-shop-id
GHN_FROM_DISTRICT_ID=1454
GHN_FROM_WARD_CODE=21211
GHN_WEBHOOK_SECRET=your-ghn-webhook-secret
